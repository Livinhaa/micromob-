# Copie para .env e ajuste. Em produção troque as senhas e o JWT_SECRET.
POSTGRES_USER=micromob
POSTGRES_PASSWORD=micromob
POSTGRES_DB=micromob

# Segredo do JWT (mínimo 16 caracteres)
JWT_SECRET=troque-este-segredo-por-um-valor-longo

# ntfy: use o servidor público OU o auto-hospedado do compose (perfil "selfhosted").
# Público:         NTFY_BASE_URL=https://ntfy.sh
# Auto-hospedado:  NTFY_BASE_URL=http://ntfy:80
NTFY_BASE_URL=https://ntfy.sh
# IMPORTANTE: tópicos públicos são legíveis por qualquer pessoa. Use um nome único e difícil de adivinhar.
NTFY_TOPIC=micromob-alertas-CHANGE-ME
# Opcional: token de acesso (servidores ntfy protegidos)
NTFY_TOKEN=

# URL pública do dashboard (usada no link "Click" da notificação)
PUBLIC_URL=http://localhost:8080

# Área de operação (centro e raio) usada na regra de geofence
GEOFENCE_LAT=-22.3147
GEOFENCE_LNG=-49.0608
GEOFENCE_RADIUS_KM=5
